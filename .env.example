# Copy to .env for local runs. Never commit a filled-in .env.

# OpenAI (used when OPENROUTER_API_KEY is unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o

# OpenRouter wins when set
OPENROUTER_API_KEY=

# Optional runtime
# GOLUM_CONTEXT_WINDOW=128000
# GOLUM_STREAM_TIMEOUT=10m
# GOLUM_LOG=/tmp/golum.log
# GOLUM_MCP_CONFIG=.golum/mcp.json

# Optional evals (scripts/run-evals.sh)
# GOLUM_EVAL_MODEL=gpt-4o
# GOLUM_EVAL_JUDGE_MODEL=
# GOLUM_EVAL_SPLIT=dev
# GOLUM_EVAL_REPETITIONS=3
# GOLUM_EVAL_TASK=
# GOLUM_EVAL_SEED=
# GOLUM_EVAL_PRICES=
# GOLUM_EVAL_ARTIFACT_DIR=
